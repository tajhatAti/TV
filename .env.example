# ---------------------------------------------------------------------------
# এগুলো সব ঐচ্ছিক! কিছু না দিলেও সার্ভার চালু হবে।
#
# প্রথমবার চালু হলে ব্রাউজারে আপনার পাবলিক লিংক খুলুন (যেমন
# https://your-app.example.com/) — সেটআপ ফর্ম আসবে। ওখানেই BOT_TOKEN,
# API_ID, API_HASH দিন; সেভ হয়ে ডিস্কে থাকবে (data/config.json), env লাগবে না।
#
# PIN কোথায় পাবেন: ডিপ্লয়ের লগে (Live logs) "SETUP PIN: 123456" লাইনটি দেখুন।
# এটা দরকার কারণ পাবলিক লিংকে যে কেউ টোকেন বদলে দিতে পারলে বট হাইজ্যাক হয়ে যেত;
# PIN ছাড়া কেউ সেভ করতে পারবে না। চাইলে নিচের SETUP_PIN দিয়ে নিজের PIN ঠিক করুন।
# ---------------------------------------------------------------------------
# SETUP_PIN=
# DEMO=1                 # নেটওয়ার্ক ছাড়া শুধু UI টেস্ট (OTP 12345 / 2FA demo1234)
# ---------------------------------------------------------------------------
# নিচের সবগুলো ঐচ্ছিক — সাধারণত কিছুই দিতে হয় না (সেটআপ পেজ থেকেই হয়)
# BOT_TOKEN=
# API_ID=
# API_HASH=
# WEBAPP_URL=
# OWNER_ID=              # আপনার numeric id → বট শুধু আপনার জন্য (সুপারিশ করা)
# AUTO_REVOKE_OTHERS=1   # সেশন বানানোর সঙ্গেই ফোন থেকে অটো লগ আউট
# REVOKE_WINDOW=900
# PORT=10000             # হোস্টিং প্ল্যাটফর্ম নিজেই দেয়
# DATA_DIR=./data        # config কোথায় সেভ হবে
# LOG_LEVEL=INFO
