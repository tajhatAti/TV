# ---------------------------------------------------------------------------
# এই ফাইলটি কপি করে .env বানান এবং নিজের মান বসান।
# .env কখনো git-এ কমিট করবেন না (সেশন/টোকেন = অ্যাকাউন্টের চাবি)।
# ---------------------------------------------------------------------------

# BotFather থেকে পাওয়া টোকেন
BOT_TOKEN=

# my.telegram.org → API development tools থেকে পাওয়া মান
API_ID=
API_HASH=

# মিনি অ্যাপের পাবলিক https লিংক (শেষে / থাকলে সমস্যা নেই)
# লোকাল টেস্টে ngrok/cloudflared টানেল দিলে সেটার https লিংক দিন।
WEBAPP_URL=

# সার্ভার পোর্ট (Render নিজে PORT দেয়, তাই সাধারণত খালি রাখলেই হয়)
PORT=10000

# 🔒 শুধু আপনার Telegram numeric id (উদাহরণ: 123456789)।
# সেট করলে বট ও মিনি অ্যাপ শুধু আপনার কাছেই কাজ করবে — বাকিরা 403 পাবে।
# নিজের id জানতে বটে /start দিয়ে @userinfobot-এ পাঠান, বা Bot API getUpdates থেকে দেখুন।
# খালি রাখলে যে কেউ আপনার বট দিয়ে নিজের সেশন বানাতে পারবে (আপনার API_ID খরচ হবে) —
# তাই সবসময় সেট করা ভালো।
OWNER_ID=

# 📵 সেশন তৈরি হওয়ার সঙ্গেই ফোন/পুরনো ডিভাইসগুলো থেকে অটো লগ আউট?
# 1 = হ্যাঁ (অটো), 0 = না — তখন মিনি অ্যাপে "অন্য ডিভাইস লগ আউট" বাটন দেখাবে।
# যেভাবেই হোক: নতুন session string বাতিল হয় না, শুধু বাকি সেশনগুলো বন্ধ হয়।
AUTO_REVOKE_OTHERS=0

# ম্যানুয়াল বাটন কত সেকেন্ড পর্যন্ত কাজ করবে (ডিফল্ট ৯০০)
# REVOKE_WINDOW=900

# 1 দিলে ডেমো মোড — কোনো আসল Telegram কল হয় না, শুধু UI ফ্লো টেস্ট।
# টেস্ট OTP: 12345 | টেস্ট 2FA পাসওয়ার্ড: demo1234
DEMO=0

# ঐচ্ছিক টিউনিং
# PENDING_TTL=900        # চলমান লগইন কত সেকেন্ড বাঁচবে
# PHONE_TTL=86400        # শেয়ার করা নম্বর কত সেকেন্ড মেমরিতে থাকবে
# INITDATA_MAX_AGE=3600  # initData কত সেকেন্ড পুরনো হলে reject
# OTP_LIMIT=3            # প্রতি ইউজার কতবার OTP চাইতে পারবে
# OTP_WINDOW=900         # rate-limit window (সেকেন্ড)
# OTP_COOLDOWN=30        # দুইবার OTP চাওয়ার মাঝে বিরতি (সেকেন্ড)
# LOG_LEVEL=INFO
