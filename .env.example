# ---------------------------------------------------------------------------
# এই ফাইলটার কিছুই লাগবে না। কোনো environment variable ছাড়াই সব কাজ করে।
#
# কীভাবে: main.py চালান → আপনার পাবলিক লিংক ব্রাউজারে খুলুন → ফর্মে
# BOT_TOKEN, API_ID, API_HASH বসিয়ে "ভেরিফাই করে সেভ করুন" চাপুন। ওটেই শেষ।
# মানগুলো data/config.json-এ সেভ থাকবে, রিডিপ্লয়েও আর দিতে হবে না।
# কোনো PIN নেই, কোনো পাসওয়ার্ড নেই, কিছু মনে রাখতে হবে না।
#
# (নিচের সবগুলো শুধু ইচ্ছা করলে — দরকার নেই)
# DEMO=1                 # শুধু UI টেস্ট (OTP 12345 / 2FA demo1234)
# PORT=10000             # হোস্টিং নিজেই দেয়
# DATA_DIR=./data        # config কোথায় থাকবে
# LOG_LEVEL=INFO
# ---------------------------------------------------------------------------
